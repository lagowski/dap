# DAP engine environment — copy to .env.local (gitignored), fill in real values,
# then load before starting the engine:
#
#   cp .env.example .env.local
#   # edit .env.local
#   set -a; source .env.local; set +a
#   uv run dap-engine start
#
# The engine reads these at startup ONLY. Restart after changes.
# Variables left blank simply disable the corresponding provider / runtime —
# you only need keys for the LLMs you actually call.


# -----------------------------------------------------------------------------
# Provider API keys (api-call runtime + matching CLI runtimes)
# -----------------------------------------------------------------------------

# Anthropic SDK (provider="anthropic") + Claude Code CLI fallback path.
# Generate at https://console.anthropic.com — note Claude Code CLI also
# accepts an OAuth login (Pro / Max plan) instead of this key.
ANTHROPIC_API_KEY=

# OpenAI SDK (provider="openai") + Codex CLI.
# Generate at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Google Gen AI SDK (provider="gemini") + Gemini CLI fallback.
# Generate at https://aistudio.google.com/app/apikey — Gemini CLI also
# accepts ``gemini auth login`` (Advanced plan) instead.
GEMINI_API_KEY=
# Optional fallback the Gemini CLI also reads.
# GOOGLE_API_KEY=

# Z.AI GLM (provider="glm") — first-class registered OpenAI-compatible
# endpoint. base_url is hardcoded; only this env var is needed.
# Generate at https://z.ai → API keys.
GLM_API_KEY=

# Custom OpenAI-compat providers (Together, OpenRouter, internal proxies, …)
# don't have a fixed env var name. The agent's ``runtime_config`` declares
# ``api_key_env``; whatever name it uses, export the same one here.
# Examples:
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=


# -----------------------------------------------------------------------------
# Engine runtime configuration
# -----------------------------------------------------------------------------

# Where the SQLite DB + LangGraph checkpoints live. Parent dir is auto-created.
# DAP_DB_PATH=./.dap/state.db

# HTTP listener.
# DAP_ENGINE_HOST=127.0.0.1
# DAP_ENGINE_PORT=7333

# Hard cap (USD) per agent dry-run from the dashboard Test panel.
# Each invocation pays real LLM tokens — keep this low while exploring.
# DAP_DRY_RUN_BUDGET_USD=0.50

# Default shell for the bash runtime adapter (CLI override:
# runtime_config.shell on the agent).
# DAP_BASH_SHELL=/bin/bash
