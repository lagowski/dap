# DAP environment variables — copy to .env.local (gitignored), fill in real
# values, then load before starting the engine:
#
#   cp .env.example .env.local
#   # edit .env.local
#   set -a; source .env.local; set +a
#   uv run dap-engine                 # or: dap start
#
# The engine reads these at process start ONLY. Restart after changes.
# Variables left blank simply disable the corresponding provider / feature —
# fill in only what you actually use.
#
# Grouped by concern:
#   1. Auth                 — JWT signing, OAuth, password-reset behaviour
#   2. CORS                 — cross-origin allow-list for the dashboard
#   3. Storage              — SQLite path or Postgres URL + pool sizing
#   4. Engine runtime       — listener, default budgets, bash shell
#   5. LLM provider keys    — Anthropic, OpenAI, Gemini, GLM, custom
#
# Production checklist + per-var rationale: see ``docs/self-hosting.md``.


# =============================================================================
# 1. Auth — REQUIRED in production
# =============================================================================

# JWT signing key for the dashboard session cookie. Opaque ``dap_*``
# API tokens are stored hashed in the DB and do **not** use this
# secret — rotating it logs out cookie sessions but leaves API
# tokens working until you revoke them in /admin/api-tokens.
#
# REQUIRED in any multi-replica or persistent deployment. When unset the
# engine generates a per-process random — fine for local dev (cookie
# sessions invalidate on every restart), but **breaks horizontally-scaled
# deploys** (each replica signs with a different key, so a request
# hitting replica B can't validate a token issued by replica A).
#
# Generate with: ``openssl rand -hex 32``
DAP_AUTH_JWT_SECRET=

# Access token lifetime (seconds). Defaults to 900 s (15 min) —
# short-lived enough that revocation via the audit log + admin
# session cleanup is sufficient without a refresh-token flow.
# DAP_AUTH_ACCESS_TTL_SECONDS=900

# When ``1`` / ``true`` / ``yes``, the password-reset flow logs the raw
# reset token at WARNING level. Useful for self-hosted dev *without* email
# delivery — the operator copies the token out of stdout and hands it to
# the user. **Keep OFF in production**: reset tokens are credentials, and
# log aggregation would routinely contain account-takeover material.
# DAP_AUTH_LOG_RESET_TOKENS=0

# Post-OAuth-callback redirect. When set, the engine redirects the browser
# to this URL with ``?token=<jwt>`` instead of returning JSON — the
# dashboard's catch-all handler at ``/api/auth/oauth/callback`` reads the
# token, sets the httpOnly cookie, and lands the user on the home page.
#
# Dev:        http://localhost:3000/api/auth/oauth/callback
# Production: https://your-dashboard.example.com/api/auth/oauth/callback
#
# Leave unset for CLI-only deployments — the engine falls back to JSON.
# DAP_AUTH_OAUTH_REDIRECT_URL=


# =============================================================================
# 1b. OAuth providers — opt-in (engine mounts the router only when both
#     client_id and client_secret are set)
# =============================================================================

# GitHub OAuth App — https://github.com/settings/developers
# DAP_OAUTH_GITHUB_CLIENT_ID=
# DAP_OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 client — https://console.cloud.google.com/apis/credentials
# DAP_OAUTH_GOOGLE_CLIENT_ID=
# DAP_OAUTH_GOOGLE_CLIENT_SECRET=


# =============================================================================
# 2. CORS — REQUIRED in production
# =============================================================================

# Comma-separated allow-list of origins the dashboard is served from.
# When unset, falls back to a **local-dev allow-list** (``http://localhost:3000``,
# ``http://127.0.0.1:3000``) — that's a safer default than ``*`` but it's
# almost certainly wrong for production. Set this explicitly.
#
# Example: DAP_CORS_ORIGINS=https://dap.example.com,https://staging.dap.example.com
# DAP_CORS_ORIGINS=


# =============================================================================
# 3. Storage — pick ONE: SQLite (default) or Postgres
# =============================================================================

# SQLite (default — fine for a single operator). Parent dir is auto-created.
# DAP_DB_PATH=./.dap/state.db

# Postgres (recommended for >1 user). Overrides DAP_DB_PATH when set.
# Use the asyncpg dialect; in-code migrations (apply_migrations) run
# automatically on engine startup — no separate ``alembic upgrade`` step.
# Example:
# DAP_DATABASE_URL=postgresql+asyncpg://dap:secret@localhost:5432/dap

# Postgres-only checkpointer pool sizing. ``min_size`` keeps that many warm
# connections; ``max_size`` is the burst ceiling across concurrent runs.
# Each connection costs ~10MB on the DB side — sizing higher trades RAM
# for tail latency under spikes.
# DAP_PG_POOL_MIN_SIZE=4
# DAP_PG_POOL_MAX_SIZE=10


# =============================================================================
# 4. Engine runtime
# =============================================================================

# HTTP listener. Bind to 0.0.0.0 in containers; 127.0.0.1 for local dev.
# DAP_ENGINE_HOST=127.0.0.1
# DAP_ENGINE_PORT=7333

# Hard cap (USD) per agent dry-run invoked from the dashboard Test panel.
# Each dry-run pays real LLM tokens — keep low while exploring.
# DAP_DRY_RUN_BUDGET_USD=0.50

# Default shell for the bash runtime adapter. Agent-level override goes in
# ``runtime_config.shell``. Defaults to ``/bin/bash``.
# DAP_BASH_SHELL=/bin/bash


# =============================================================================
# 4b. Private template registry (#385) — optional
# =============================================================================
#
# Enables ``POST /pipelines/import-from-url`` so operators can import
# pipeline bundles from trusted private URLs (e.g. a company-internal
# git repo holding ``.pipeline-bundle.json`` files). Off by default —
# requires an explicit allow-list of hostnames.
#
# See ``docs/auth.md`` (Template registry section) for the operator
# walkthrough.

# Comma-separated allow-list of hostnames the engine will fetch bundles
# from. Hostname must match LITERALLY (no wildcards). HTTPS is enforced
# for every host except ``localhost``/``127.0.0.1`` (dev only).
# DAP_TEMPLATE_REGISTRY_ALLOWED_HOSTS=raw.githubusercontent.com,gitlab.internal.com

# Optional Bearer token attached to every outbound bundle fetch.
# Useful for private GitHub/GitLab repos that require a PAT. Per-host
# tokens (for multiple registries with different credentials) land in
# a follow-up ticket.
# DAP_TEMPLATE_REGISTRY_AUTH_TOKEN=ghp_xxxxxxxxxxxxxxxx


# =============================================================================
# 5. LLM provider keys
# -----------------------------------------------------------------------------
# Only needed for runtimes you actually call. Empty value → that provider
# is disabled but the engine still starts (other runtimes work).
# =============================================================================

# Anthropic SDK (provider="anthropic") + Claude Code CLI fallback path.
# Generate at https://console.anthropic.com — Claude Code CLI also accepts
# ``claude auth login`` (Pro / Max plan) instead of an API key.
ANTHROPIC_API_KEY=

# OpenAI SDK (provider="openai") + Codex CLI.
# Generate at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Google Gen AI SDK (provider="gemini") + Gemini CLI fallback.
# Generate at https://aistudio.google.com/app/apikey — Gemini CLI also
# accepts ``gemini auth login`` (Advanced plan) instead.
GEMINI_API_KEY=
# Optional fallback the Gemini CLI also reads.
# GOOGLE_API_KEY=

# Z.AI GLM (provider="glm") — first-class registered OpenAI-compatible
# endpoint. base_url is hardcoded; only this env var is needed.
# Generate at https://z.ai → API keys.
GLM_API_KEY=

# OpenRouter (provider="openrouter") — first-class registered multi-model
# gateway speaking the OpenAI Chat Completions shape. base_url is hardcoded;
# only this env var is needed. ``model_id`` is a slash-namespaced id like
# ``anthropic/claude-3.5-sonnet`` or ``deepseek/deepseek-v3-pro``.
# Generate at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Custom OpenAI-compat providers (Together, llama.cpp servers, internal
# proxies, …) don't have a fixed env var name. The agent's ``runtime_config``
# declares ``api_key_env``; whatever name it uses, export the same one here.
# Examples:
# TOGETHER_API_KEY=
