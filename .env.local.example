# .env.local — copy this file to .env.local and fill in your values.
#
# IMPORTANT: values containing !, *, $, or `, MUST be single-quoted.
# Bash's history-expansion + variable substitution would otherwise
# silently mangle them when `scripts/dev` sources this file. The
# engine then fails with confusing LOGIN_BAD_CREDENTIALS / 401s
# even though the credentials are typed correctly.
#
#   DAP_DATABASE_URL='postgresql+asyncpg://dap:p4ss!w0rd@host/dap'  ← correct
#   DAP_DATABASE_URL="postgresql+asyncpg://dap:p4ss!w0rd@host/dap"  ← wrong
#
# This file is .gitignored after copying to .env.local. The full set
# of supported settings lives in .env.example.

# ── Database ─────────────────────────────────────────────────────────
# Leave commented to use the local SQLite file at .dap/state.db
# (single-user dev default — fine for one operator, NOT for shared
#  deployments). When set, the engine refuses to start if the URL
# is unreachable — it will NOT silently fall back to SQLite.

# DAP_DATABASE_URL='postgresql+asyncpg://dap:password@10.0.0.5:5432/dap'

# ── GitHub tokens ────────────────────────────────────────────────────
# Three separate tokens recommended so that read / write / merge
# scopes are isolated (least-privilege).

# GH_TOKEN_ISSUES='ghp_...'   # Read issues, fetch PR reviews
# GH_TOKEN_CODE='ghp_...'     # Push commits, create PRs
# GH_TOKEN_MERGE='ghp_...'    # Merge PRs (often a separate bot account)

# ── AI / LLM providers ───────────────────────────────────────────────
# Only the providers you actually use need to be set.

# ANTHROPIC_API_KEY='sk-ant-...'
# OPENAI_API_KEY='sk-...'
# GEMINI_API_KEY='...'
# OLLAMA_BASE_URL='http://localhost:11434'

# ── Auth ─────────────────────────────────────────────────────────────
# 32+ bytes of randomness. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without an explicit value the engine mints a new secret per start,
# which invalidates outstanding tokens on every restart — fine for
# solo local dev, bad for any shared environment.

# DAP_AUTH_JWT_SECRET='replace-me-with-a-real-random-secret'

# ── OAuth (optional) ─────────────────────────────────────────────────
# Set both client_id and client_secret to enable each provider.
# Missing or partially-set credentials are ignored without a startup
# error so a self-host install can run email+password only.

# DAP_OAUTH_GITHUB_CLIENT_ID='...'
# DAP_OAUTH_GITHUB_CLIENT_SECRET='...'
# DAP_OAUTH_GOOGLE_CLIENT_ID='...'
# DAP_OAUTH_GOOGLE_CLIENT_SECRET='...'
