#!/usr/bin/env bash
#
# Pre-push hook — łączy dwa lokalne safety-nety:
#
#  (1) Blokada bezpośredniego pushu do `main` / `develop`. Remote
#      branch protection po stronie GitHub jest właściwym
#      enforcementem; ten check zatrzymuje pomyłkę zanim w ogóle
#      doleci do origin.
#
#  (2) `pre-commit run --all-files` przed pushem. CI uruchamia
#      `ruff format --check`, `ruff check`, `mypy`, `pytest`
#      identycznie; jeśli odpalimy je tu, push do branch'a feature
#      gwarantuje że tracking się nie wywróci o trywialny format-fix
#      autofix'em (powtarzający się scenariusz w sub-A2 i sub-A3).
#
# Aktywacja: git config core.hooksPath .githooks

set -euo pipefail

protected_branches=("main" "develop")
remote="$1"

# Format stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # remote_ref ma format refs/heads/<branch>
  branch="${remote_ref#refs/heads/}"

  for protected in "${protected_branches[@]}"; do
    if [[ "$branch" == "$protected" ]]; then
      # Sprawdź czy to delete ref (push --delete)
      zero_sha="0000000000000000000000000000000000000000"
      if [[ "$local_sha" == "$zero_sha" ]]; then
        echo "✗ Blokada: usuwanie branch '$protected' jest zabronione."
        exit 1
      fi

      echo "✗ Blokada: bezpośredni push do '$protected' jest zabroniony."
      echo ""
      echo "  Workflow:"
      echo "    1. Utwórz branch z develop: git checkout -b issue/<nr>-<slug>"
      echo "    2. Commituj zmiany na tym branchu"
      echo "    3. Push branch: git push -u origin issue/<nr>-<slug>"
      echo "    4. Otwórz PR → $protected przez gh pr create"
      echo ""
      echo "  Override (use with caution):"
      echo "    git push --no-verify $remote $branch"
      echo ""
      exit 1
    fi
  done
done

# (2) Pre-commit run — only when the tool is installed locally. The
# block is opt-in (skips silently when `pre-commit` isn't on PATH) so
# contributors who haven't run `uv tool install pre-commit` aren't
# forced to do so just to push. CI still enforces format/lint/types,
# so this hook only adds *earlier* feedback for those who've installed
# the tool — there's no functional regression for skippers.
if command -v pre-commit >/dev/null 2>&1; then
  echo "→ pre-push: running pre-commit (skip with: git push --no-verify)"
  if ! pre-commit run --all-files; then
    echo ""
    echo "✗ pre-commit failed — fix the issues above and try again."
    echo "  (the same checks run in CI, so an unfixed push will fail there too)"
    exit 1
  fi
fi

exit 0
