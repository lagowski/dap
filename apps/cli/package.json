{
  "name": "@dap/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "dap": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
