{
  "name": "@dap/engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dap-engine": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/bin.ts",
    "start": "node dist/bin.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@dap/types": "workspace:*",
    "@dap/runtimes": "workspace:*",
    "@langchain/langgraph": "^0.2.19",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.35.3",
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "drizzle-kit": "^0.26.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
