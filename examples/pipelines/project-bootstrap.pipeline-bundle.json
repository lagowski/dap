{
  "schema_version": "pipeline-export/2",
  "pipeline": {
    "name": "Project Bootstrap — arena verdict to scaffolded, cortex-managed project",
    "description": "Gate-supervised pipeline that bootstraps a new project from an idea-arena verdict: validate params, scope the MVP slice (LLM), create + seed the GitHub repo, wire the PR-review-gate, provision a dedicated database, register the project under cortex, then decompose the MVP into INVEST-sized GitHub issues for issue-implementer. Five human approval gates separate the irreversible steps.",
    "schema_version": "langgraph/1.0",
    "state_schema_ref": "BootstrapState.v1",
    "entry_point": "validate_params",
    "nodes": [
      {
        "id": "validate_params",
        "agent_id": "pb_validate_params",
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "gate_params",
        "agent_id": "pb_gate_params",
        "position": {
          "x": 100,
          "y": 0
        }
      },
      {
        "id": "scope_mvp",
        "agent_id": "pb_scope_mvp",
        "position": {
          "x": 200,
          "y": 0
        }
      },
      {
        "id": "gate_scope",
        "agent_id": "pb_gate_scope",
        "position": {
          "x": 300,
          "y": 0
        }
      },
      {
        "id": "scaffold_repo",
        "agent_id": "pb_scaffold_repo",
        "position": {
          "x": 400,
          "y": 0
        }
      },
      {
        "id": "gate_scaffold",
        "agent_id": "pb_gate_scaffold",
        "position": {
          "x": 500,
          "y": 0
        }
      },
      {
        "id": "wire_gate",
        "agent_id": "pb_wire_gate",
        "position": {
          "x": 600,
          "y": 0
        }
      },
      {
        "id": "provision_db",
        "agent_id": "pb_provision_db",
        "position": {
          "x": 700,
          "y": 0
        }
      },
      {
        "id": "gate_provision",
        "agent_id": "pb_gate_provision",
        "position": {
          "x": 800,
          "y": 0
        }
      },
      {
        "id": "register_project",
        "agent_id": "pb_register_project",
        "position": {
          "x": 900,
          "y": 0
        }
      },
      {
        "id": "decompose_issues",
        "agent_id": "pb_decompose_issues",
        "position": {
          "x": 1000,
          "y": 0
        }
      },
      {
        "id": "gate_decompose",
        "agent_id": "pb_gate_decompose",
        "position": {
          "x": 1100,
          "y": 0
        }
      },
      {
        "id": "finalize",
        "agent_id": "pb_finalize",
        "position": {
          "x": 1200,
          "y": 0
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "validate_params",
        "target": "gate_params"
      },
      {
        "id": "e2",
        "source": "gate_params",
        "target": "scope_mvp",
        "condition": {
          "field": "extensions.gate_params_approved",
          "op": "eq",
          "value": true
        }
      },
      {
        "id": "e3",
        "source": "gate_params",
        "target": "__end__",
        "condition": {
          "field": "extensions.gate_params_approved",
          "op": "eq",
          "value": false
        }
      },
      {
        "id": "e4",
        "source": "scope_mvp",
        "target": "gate_scope"
      },
      {
        "id": "e5",
        "source": "gate_scope",
        "target": "scaffold_repo",
        "condition": {
          "field": "extensions.gate_scope_approved",
          "op": "eq",
          "value": true
        }
      },
      {
        "id": "e6",
        "source": "gate_scope",
        "target": "__end__",
        "condition": {
          "field": "extensions.gate_scope_approved",
          "op": "eq",
          "value": false
        }
      },
      {
        "id": "e7",
        "source": "scaffold_repo",
        "target": "gate_scaffold"
      },
      {
        "id": "e8",
        "source": "gate_scaffold",
        "target": "wire_gate"
      },
      {
        "id": "e9",
        "source": "wire_gate",
        "target": "provision_db"
      },
      {
        "id": "e10",
        "source": "provision_db",
        "target": "gate_provision"
      },
      {
        "id": "e11",
        "source": "gate_provision",
        "target": "register_project",
        "condition": {
          "field": "extensions.gate_provision_approved",
          "op": "eq",
          "value": true
        }
      },
      {
        "id": "e12",
        "source": "gate_provision",
        "target": "__end__",
        "condition": {
          "field": "extensions.gate_provision_approved",
          "op": "eq",
          "value": false
        }
      },
      {
        "id": "e13",
        "source": "register_project",
        "target": "decompose_issues"
      },
      {
        "id": "e14",
        "source": "decompose_issues",
        "target": "gate_decompose",
        "condition": {
          "type": "not",
          "children": [
            {
              "type": "comparison",
              "field": "extensions.gate_decompose_approved",
              "operator": "==",
              "value": true
            }
          ]
        }
      },
      {
        "id": "e15",
        "source": "decompose_issues",
        "target": "finalize",
        "condition": {
          "field": "extensions.gate_decompose_approved",
          "op": "eq",
          "value": true
        }
      },
      {
        "id": "e16",
        "source": "gate_decompose",
        "target": "decompose_issues",
        "condition": {
          "field": "extensions.gate_decompose_approved",
          "op": "eq",
          "value": true
        }
      },
      {
        "id": "e17",
        "source": "gate_decompose",
        "target": "__end__",
        "condition": {
          "field": "extensions.gate_decompose_approved",
          "op": "eq",
          "value": false
        }
      },
      {
        "id": "e18",
        "source": "finalize",
        "target": "__end__"
      }
    ],
    "defaults": {
      "max_attempts": 3,
      "budget_limit_usd": 25.0,
      "approval_required_nodes": [
        "gate_params",
        "gate_scope",
        "gate_scaffold",
        "gate_provision",
        "gate_decompose"
      ]
    }
  },
