# DAP standalone deployment — copy to ``.env`` and fill in.
#
# Most env vars also work outside Docker (e.g. when running via
# ``pipx install dap-cli && dap start``).

# ─────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────

# 32-byte random secret signing JWTs. Mint with ``openssl rand -hex 32``.
# Rotating this invalidates every outstanding session.
DAP_AUTH_JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Auth (optional — sensible defaults)
# ─────────────────────────────────────────────────────────────────────

# JWT lifetime. 15 min default bounds the revocation latency we accept
# (since we don't ship a blacklist).
DAP_AUTH_ACCESS_TTL_SECONDS=900

# When set, the engine logs reset tokens at WARNING. Dev-only — leave
# off in prod or your logs carry account-takeover material.
# DAP_AUTH_LOG_RESET_TOKENS=0

# ─────────────────────────────────────────────────────────────────────
# CORS — explicit list for prod
# ─────────────────────────────────────────────────────────────────────

# Comma-separated. Without this, the engine falls back to a local-dev
# allow-list (http://localhost:3000 etc.). Set to your dashboard URL.
# DAP_CORS_ORIGINS=https://dap.example.com

# ─────────────────────────────────────────────────────────────────────
# OAuth (optional — providers activate when both ID + secret are set)
# ─────────────────────────────────────────────────────────────────────

# GitHub:   https://github.com/settings/developers (new OAuth app)
# DAP_OAUTH_GITHUB_CLIENT_ID=
# DAP_OAUTH_GITHUB_CLIENT_SECRET=

# Google:   https://console.cloud.google.com/apis/credentials (OAuth client ID)
# DAP_OAUTH_GOOGLE_CLIENT_ID=
# DAP_OAUTH_GOOGLE_CLIENT_SECRET=

# Where OAuth callbacks redirect after the provider signs the user in.
# Must point at the dashboard's ``/api/auth/oauth/callback`` route.
# Without this the engine returns the JWT as JSON and the browser
# can't intercept it.
# DAP_AUTH_OAUTH_REDIRECT_URL=https://dap.example.com/api/auth/oauth/callback

# ─────────────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────────────

# Default SQLite path inside the container. Mapped to a docker volume
# in docker-compose.yml.
DAP_DB_PATH=/data/state.db

# Postgres (recommended for >1 user). Uncomment the postgres service
# in docker-compose.yml + uncomment this URL.
# DAP_DATABASE_URL=postgresql+psycopg://dap:${POSTGRES_PASSWORD}@postgres:5432/dap
# POSTGRES_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# Compose-only
# ─────────────────────────────────────────────────────────────────────

# Image tag (matches the GHCR release tag). Default ``latest``; pin to
# a specific version in prod (e.g. ``0.3.0``) to avoid surprise updates.
# DAP_IMAGE_TAG=0.3.0

# Host port mappings. Change if you have other services on these ports.
# DAP_ENGINE_PORT=7333
# DAP_DASHBOARD_PORT=3000
