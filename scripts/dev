#!/usr/bin/env bash
# scripts/dev — bring up the full DAP stack (engine + dashboard) in one shot.
#
# Auto-loads .env.local (if present), runs uv-managed engine on :7333 and the
# Next.js dashboard on :3000 in parallel, prefixes both log streams, and tears
# everything down on Ctrl+C.
#
# Usage:
#   ./scripts/dev                     # start both
#   ./scripts/dev --install           # also run uv sync + pnpm install first
#   DAP_DEV_INSTALL=1 ./scripts/dev   # equivalent to --install
#
# The script is idempotent re: cwd — it always cd's to repo root before
# touching anything, so calling it from a subdir works.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# ----- args ------------------------------------------------------------------

DO_INSTALL="${DAP_DEV_INSTALL:-0}"
for arg in "$@"; do
  case "$arg" in
    --install) DO_INSTALL=1 ;;
    -h|--help)
      sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "[dap] unknown argument: $arg" >&2; exit 2 ;;
  esac
done

# ----- pre-flight ------------------------------------------------------------

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "[dap] missing required tool: $1" >&2
    echo "[dap] see README Quickstart for install steps" >&2
    exit 1
  fi
}
need uv
need pnpm

# ----- env -------------------------------------------------------------------

if [[ -f .env.local ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env.local
  set +a
  echo "[dap] loaded .env.local"
else
  echo "[dap] no .env.local — provider keys will be empty (api-call adapter will 401)"
fi

# ----- optional install ------------------------------------------------------

if [[ "$DO_INSTALL" == "1" ]]; then
  echo "[dap] uv sync --all-packages"
  uv sync --all-packages
  echo "[dap] pnpm install (apps/dashboard)"
  (cd apps/dashboard && pnpm install)
fi

# ----- run -------------------------------------------------------------------

ENGINE_PID=""
DASH_PID=""

cleanup() {
  trap - INT TERM EXIT
  echo
  echo "[dap] shutting down..."
  for pid in "$ENGINE_PID" "$DASH_PID"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done
  # Give children a beat to flush, then SIGKILL anything still alive.
  sleep 1
  for pid in "$ENGINE_PID" "$DASH_PID"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  done
  wait 2>/dev/null || true
  echo "[dap] done"
}
trap cleanup INT TERM EXIT

ENGINE_PORT="${DAP_ENGINE_PORT:-7333}"
echo "[dap] starting engine on http://127.0.0.1:${ENGINE_PORT}"
# awk fflush() keeps logs interactive across the pipe on both BSD and GNU awk.
uv run dap-engine start 2>&1 | awk '{ print "[engine] " $0; fflush(); }' &
ENGINE_PID=$!

echo "[dap] starting dashboard on http://localhost:3000"
(cd apps/dashboard && pnpm dev 2>&1 | awk '{ print "[dashboard] " $0; fflush(); }') &
DASH_PID=$!

# Poll both — exit (and let trap clean up) as soon as either dies, so the user
# notices a crash instead of staring at a half-running stack. ``kill -0`` is a
# liveness probe that works in bash 3.2 (no ``wait -n`` dependency).
while kill -0 "$ENGINE_PID" 2>/dev/null && kill -0 "$DASH_PID" 2>/dev/null; do
  sleep 1
done

if ! kill -0 "$ENGINE_PID" 2>/dev/null; then
  echo "[dap] engine exited — bringing down dashboard"
elif ! kill -0 "$DASH_PID" 2>/dev/null; then
  echo "[dap] dashboard exited — bringing down engine"
fi
